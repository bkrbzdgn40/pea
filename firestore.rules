rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isNullableNumber(value) {
      return value == null || value is number;
    }

    function isScore(value) {
      return value is number && value >= 0 && value <= 100;
    }

    function isNullableScore(value) {
      return value == null || isScore(value);
    }

    function isNullableInt(value) {
      return value == null || value is int;
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isNullableNonNegativeInt(value) {
      return value == null || isNonNegativeInt(value);
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function isNullableNonNegativeNumber(value) {
      return value == null || isNonNegativeNumber(value);
    }

    function isNullableBool(value) {
      return value == null || value is bool;
    }

    function isNullableList(value) {
      return value == null || value is list;
    }

    function isNullableTempoMeasurementStatus(value) {
      return value == null ||
        value == 'eligible' ||
        value == 'unavailable';
    }

    function isNullableTempoQuality(value) {
      return value == null ||
        value == 'unavailable' ||
        value == 'target' ||
        value == 'tooFast' ||
        value == 'tooSlow';
    }

    function isNullableTempoSeverity(value) {
      return value == null ||
        value == 'none' ||
        value == 'mild' ||
        value == 'strong';
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isNullableUnitInterval(value) {
      return value == null ||
        (value is number && value >= 0 && value <= 1);
    }

    function isPreparationOutcome(value) {
      return value == 'passed' ||
        value == 'overridden' ||
        value == 'legacyUnknown';
    }

    function isSessionMeasurementQuality(value) {
      return value == 'high' ||
        value == 'moderate' ||
        value == 'limited' ||
        value == 'insufficient' ||
        value == 'unknown';
    }

    function hasValidSessionMeasurementEvidence(data) {
      let evidenceKeys = [
        'preparationOutcome',
        'measurementQuality',
        'averageMeasurementConfidence',
        'measurementSampleCount',
      ];
      let hasNoEvidenceFields = !data.keys().hasAny(evidenceKeys);
      let hasAllEvidenceFields = data.keys().hasAll(evidenceKeys);
      let preparationOutcome = data.get('preparationOutcome', null);
      let confidence = data.get('averageMeasurementConfidence', null);
      let sampleCount = data.get('measurementSampleCount', null);
      let quality = data.get('measurementQuality', null);
      let isCurrentShape = hasAllEvidenceFields &&
        isPreparationOutcome(preparationOutcome) &&
        isSessionMeasurementQuality(quality) &&
        isNullableUnitInterval(confidence) &&
        isNonNegativeInt(sampleCount) &&
        (
          (confidence == null && sampleCount == 0 && quality == 'unknown') ||
          (confidence != null && sampleCount == 1 &&
            quality == 'insufficient') ||
          (confidence != null && sampleCount >= 2 &&
            (
              quality == 'limited' ||
              (
                preparationOutcome == 'passed' &&
                (quality == 'high' || quality == 'moderate')
              )
            ))
        );
      return hasNoEvidenceFields || isCurrentShape;
    }

    function isMeasurementConfidenceIssueList(value) {
      return value is list && value.hasOnly([
        'missing_required_landmark',
        'low_landmark_likelihood',
        'low_mean_likelihood',
        'missing_required_signal',
        'non_finite_geometry',
        'degenerate_geometry',
        'temporal_history_unavailable',
        'temporal_discontinuity',
        'coverage_interruption',
        'side_switch_during_rep',
        'legacy_scalar_only',
      ]);
    }

    function isMeasurementConfidenceBreakdown(value) {
      let keys = value.keys();
      return value is map &&
        keys.hasOnly([
          'landmarkLikelihood',
          'signalAvailability',
          'geometryPlausibility',
          'temporalContinuity',
          'combined',
          'issues',
        ]) &&
        keys.size() == 6 &&
        isNullableUnitInterval(value.get('landmarkLikelihood', null)) &&
        isNullableUnitInterval(value.get('signalAvailability', null)) &&
        isNullableUnitInterval(value.get('geometryPlausibility', null)) &&
        isNullableUnitInterval(value.get('temporalContinuity', null)) &&
        isNullableUnitInterval(value.get('combined', null)) &&
        isMeasurementConfidenceIssueList(value.get('issues', null));
    }

    function isNullableMeasurementConfidenceBreakdown(value) {
      return value == null || isMeasurementConfidenceBreakdown(value);
    }

    function hasSessionFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'exerciseType',
        'analysisKind',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'totalReps',
        'validReps',
        'lowConfidenceReps',
        'invalidReps',
        'averageScore',
        'bestScore',
        'worstScore',
        'formWarningCount',
        'holdDurationSeconds',
        'bestHoldSeconds',
        'holdFormBreakCount',
        'preparationOutcome',
        'measurementQuality',
        'averageMeasurementConfidence',
        'measurementSampleCount',
        'createdAt',
        'updatedAt',
      ]) &&
      request.resource.data.keys().hasAll([
        'id',
        'ownerId',
        'exerciseType',
        'analysisKind',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'totalReps',
        'validReps',
        'lowConfidenceReps',
        'invalidReps',
        'averageScore',
        'bestScore',
        'worstScore',
        'formWarningCount',
        'holdDurationSeconds',
        'bestHoldSeconds',
        'holdFormBreakCount',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidSessionShape(userId, sessionId) {
      return request.resource.data.id is string &&
        request.resource.data.id == sessionId &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId == userId &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.exerciseType is string &&
        request.resource.data.analysisKind is string &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.endedAt is timestamp &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.endedAt >= request.resource.data.startedAt &&
        isNonNegativeInt(request.resource.data.durationSeconds) &&
        isNonNegativeInt(request.resource.data.totalReps) &&
        isNonNegativeInt(request.resource.data.validReps) &&
        isNonNegativeInt(request.resource.data.lowConfidenceReps) &&
        isNonNegativeInt(request.resource.data.invalidReps) &&
        request.resource.data.validReps +
          request.resource.data.lowConfidenceReps <=
          request.resource.data.totalReps &&
        isScore(request.resource.data.averageScore) &&
        isScore(request.resource.data.bestScore) &&
        isScore(request.resource.data.worstScore) &&
        isNonNegativeInt(request.resource.data.formWarningCount) &&
        isNonNegativeNumber(request.resource.data.holdDurationSeconds) &&
        isNonNegativeNumber(request.resource.data.bestHoldSeconds) &&
        isNonNegativeInt(request.resource.data.holdFormBreakCount) &&
        hasValidSessionMeasurementEvidence(request.resource.data);
    }

    function isValidSessionCreate(userId, sessionId) {
      return isOwner(userId) &&
        hasSessionFields() &&
        hasValidSessionShape(userId, sessionId);
    }

    function isValidSessionUpdate(userId, sessionId) {
      return isOwner(userId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.id == resource.data.id &&
        hasSessionFields() &&
        hasValidSessionShape(userId, sessionId);
    }

    function hasRepFields(data) {
      return data.keys().hasOnly([
        'id',
        'ownerId',
        'sessionId',
        'exerciseType',
        'analysisKind',
        'repIndex',
        'score',
        'isValid',
        'validationStatus',
        'invalidReason',
        'validationReasons',
        'endedAt',
        'durationSeconds',
        'minPrimaryMetric',
        'worstFormMetric',
        'descentMillis',
        'ascentMillis',
        'hadFormViolation',
        'hadCoverageDrop',
        'switchedSideDuringRep',
        'completedPhaseSequence',
        'selectedSide',
        'measurementConfidence',
        'confidence',
        'primaryRom',
        'eccentricMillis',
        'concentricMillis',
        'tempoMeasurementStatus',
        'tempoMeasurementIssues',
        'tempoQuality',
        'tempoSeverity',
        'tempoReasons',
        'tempoIncludedInScore',
        'tempoTotalMillis',
        'techniqueObservations',
        'coverageQuality',
        'feedback',
        'createdAt',
      ]);
    }

    function hasValidRepShape(data, userId, sessionId, repId) {
      let validationReasons = data.get('validationReasons', null);
      let measurementConfidence = data.get('measurementConfidence', null);
      let confidence = data.get('confidence', null);
      return data.id == repId &&
        data.ownerId == userId &&
        data.sessionId == sessionId &&
        data.exerciseType is string &&
        data.analysisKind is string &&
        data.repIndex is int &&
        data.repIndex >= 1 &&
        data.isValid is bool &&
        data.createdAt is timestamp &&
        isNullableScore(data.get('score', null)) &&
        isNullableString(data.get('validationStatus', null)) &&
        isNullableString(data.get('invalidReason', null)) &&
        (validationReasons == null || validationReasons is list) &&
        isNullableTimestamp(data.get('endedAt', null)) &&
        isNullableNonNegativeNumber(data.get('durationSeconds', null)) &&
        isNullableNumber(data.get('minPrimaryMetric', null)) &&
        isNullableNumber(data.get('worstFormMetric', null)) &&
        isNullableNonNegativeInt(data.get('descentMillis', null)) &&
        isNullableNonNegativeInt(data.get('ascentMillis', null)) &&
        isNullableBool(data.get('hadFormViolation', null)) &&
        isNullableBool(data.get('hadCoverageDrop', null)) &&
        isNullableBool(data.get('switchedSideDuringRep', null)) &&
        isNullableBool(data.get('completedPhaseSequence', null)) &&
        isNullableString(data.get('selectedSide', null)) &&
        isNullableMeasurementConfidenceBreakdown(measurementConfidence) &&
        isNullableUnitInterval(confidence) &&
        (
          measurementConfidence == null ||
          confidence == measurementConfidence.get('combined', null)
        ) &&
        isNullableNonNegativeNumber(data.get('primaryRom', null)) &&
        isNullableNonNegativeInt(data.get('eccentricMillis', null)) &&
        isNullableNonNegativeInt(data.get('concentricMillis', null)) &&
        isNullableTempoMeasurementStatus(
          data.get('tempoMeasurementStatus', null),
        ) &&
        isNullableList(data.get('tempoMeasurementIssues', null)) &&
        isNullableTempoQuality(data.get('tempoQuality', null)) &&
        isNullableTempoSeverity(data.get('tempoSeverity', null)) &&
        isNullableList(data.get('tempoReasons', null)) &&
        isNullableBool(data.get('tempoIncludedInScore', null)) &&
        isNullableNonNegativeInt(data.get('tempoTotalMillis', null)) &&
        isNullableList(data.get('techniqueObservations', null)) &&
        isNullableUnitInterval(data.get('coverageQuality', null)) &&
        isNullableString(data.get('feedback', null));
    }

    function isValidRepWrite(userId, sessionId, repId) {
      let data = request.resource.data;
      return isOwner(userId) &&
        hasRepFields(data) &&
        hasValidRepShape(data, userId, sessionId, repId);
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isValidSessionCreate(userId, sessionId);
        allow update: if isValidSessionUpdate(userId, sessionId);
        allow delete: if isOwner(userId);

        match /reps/{repId} {
          allow read: if isOwner(userId);
          allow create, update: if isValidRepWrite(
            userId,
            sessionId,
            repId,
          );
          allow delete: if isOwner(userId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
