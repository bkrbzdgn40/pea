rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isNullableNumber(value) {
      return value == null || value is number;
    }

    function isScore(value) {
      return value is number && value >= 0 && value <= 100;
    }

    function isNullableScore(value) {
      return value == null || isScore(value);
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isNullableNonNegativeInt(value) {
      return value == null || isNonNegativeInt(value);
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function isNullableNonNegativeNumber(value) {
      return value == null || isNonNegativeNumber(value);
    }

    function isNullableBool(value) {
      return value == null || value is bool;
    }

    function isNullableList(value) {
      return value == null || value is list;
    }

    function isNullableTempoMeasurementStatus(value) {
      return value == null ||
        value == 'eligible' ||
        value == 'unavailable';
    }

    function isNullableTempoQuality(value) {
      return value == null ||
        value == 'unavailable' ||
        value == 'target' ||
        value == 'tooFast' ||
        value == 'tooSlow';
    }

    function isNullableTempoSeverity(value) {
      return value == null ||
        value == 'none' ||
        value == 'mild' ||
        value == 'strong';
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isNullableTimezoneOffsetMinutes(value) {
      return value == null ||
        (value is int && value >= -840 && value <= 840);
    }

    function isNullableUnitInterval(value) {
      return value == null ||
        (value is number && value >= 0 && value <= 1);
    }

    function isPreparationOutcome(value) {
      return value == 'passed' ||
        value == 'overridden' ||
        value == 'legacyUnknown';
    }

    function isSessionMeasurementQuality(value) {
      return value == 'high' ||
        value == 'moderate' ||
        value == 'limited' ||
        value == 'insufficient' ||
        value == 'unknown';
    }

    function hasValidSessionMeasurementEvidence(data) {
      let evidenceKeys = [
        'preparationOutcome',
        'measurementQuality',
        'averageMeasurementConfidence',
        'measurementSampleCount',
      ];
      let hasNoEvidenceFields = !data.keys().hasAny(evidenceKeys);
      let hasAllEvidenceFields = data.keys().hasAll(evidenceKeys);
      let preparationOutcome = data.get('preparationOutcome', null);
      let confidence = data.get('averageMeasurementConfidence', null);
      let sampleCount = data.get('measurementSampleCount', null);
      let quality = data.get('measurementQuality', null);
      let isCurrentShape = hasAllEvidenceFields &&
        isPreparationOutcome(preparationOutcome) &&
        isSessionMeasurementQuality(quality) &&
        isNullableUnitInterval(confidence) &&
        isNonNegativeInt(sampleCount) &&
        (
          (confidence == null && sampleCount == 0 && quality == 'unknown') ||
          (confidence != null && sampleCount == 1 &&
            quality == 'insufficient') ||
          (confidence != null && sampleCount >= 2 &&
            (
              quality == 'limited' ||
              (
                preparationOutcome == 'passed' &&
                (quality == 'high' || quality == 'moderate')
              )
            ))
        );
      return hasNoEvidenceFields || isCurrentShape;
    }

    function isMeasurementConfidenceIssueList(value) {
      return value is list && value.hasOnly([
        'missing_required_landmark',
        'low_landmark_likelihood',
        'low_mean_likelihood',
        'missing_required_signal',
        'non_finite_geometry',
        'degenerate_geometry',
        'temporal_history_unavailable',
        'temporal_discontinuity',
        'coverage_interruption',
        'side_switch_during_rep',
        'legacy_scalar_only',
      ]);
    }

    function isMeasurementConfidenceBreakdown(value) {
      let keys = value.keys();
      return value is map &&
        keys.hasOnly([
          'landmarkLikelihood',
          'signalAvailability',
          'geometryPlausibility',
          'temporalContinuity',
          'combined',
          'issues',
        ]) &&
        keys.size() == 6 &&
        isNullableUnitInterval(value.get('landmarkLikelihood', null)) &&
        isNullableUnitInterval(value.get('signalAvailability', null)) &&
        isNullableUnitInterval(value.get('geometryPlausibility', null)) &&
        isNullableUnitInterval(value.get('temporalContinuity', null)) &&
        isNullableUnitInterval(value.get('combined', null)) &&
        isMeasurementConfidenceIssueList(value.get('issues', null));
    }

    function isNullableMeasurementConfidenceBreakdown(value) {
      return value == null || isMeasurementConfidenceBreakdown(value);
    }

    function hasSessionFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'exerciseType',
        'analysisKind',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'totalReps',
        'validReps',
        'lowConfidenceReps',
        'invalidReps',
        'averageScore',
        'bestScore',
        'worstScore',
        'formWarningCount',
        'holdDurationSeconds',
        'bestHoldSeconds',
        'holdFormBreakCount',
        'preparationOutcome',
        'measurementQuality',
        'averageMeasurementConfidence',
        'measurementSampleCount',
        'timezoneOffsetMinutes',
        'createdAt',
        'updatedAt',
      ]) &&
      request.resource.data.keys().hasAll([
        'id',
        'ownerId',
        'exerciseType',
        'analysisKind',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'totalReps',
        'validReps',
        'lowConfidenceReps',
        'invalidReps',
        'averageScore',
        'bestScore',
        'worstScore',
        'formWarningCount',
        'holdDurationSeconds',
        'bestHoldSeconds',
        'holdFormBreakCount',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidSessionShape(userId, sessionId) {
      return request.resource.data.id is string &&
        request.resource.data.id == sessionId &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId == userId &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.exerciseType is string &&
        request.resource.data.analysisKind is string &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.endedAt is timestamp &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.endedAt >= request.resource.data.startedAt &&
        isNonNegativeInt(request.resource.data.durationSeconds) &&
        isNonNegativeInt(request.resource.data.totalReps) &&
        isNonNegativeInt(request.resource.data.validReps) &&
        isNonNegativeInt(request.resource.data.lowConfidenceReps) &&
        isNonNegativeInt(request.resource.data.invalidReps) &&
        request.resource.data.validReps +
          request.resource.data.lowConfidenceReps <=
          request.resource.data.totalReps &&
        isScore(request.resource.data.averageScore) &&
        isScore(request.resource.data.bestScore) &&
        isScore(request.resource.data.worstScore) &&
        isNonNegativeInt(request.resource.data.formWarningCount) &&
        isNonNegativeNumber(request.resource.data.holdDurationSeconds) &&
        isNonNegativeNumber(request.resource.data.bestHoldSeconds) &&
        isNonNegativeInt(request.resource.data.holdFormBreakCount) &&
        isNullableTimezoneOffsetMinutes(
          request.resource.data.get('timezoneOffsetMinutes', null)
        ) &&
        hasValidSessionMeasurementEvidence(request.resource.data);
    }

    function isRepChallengeExercise(value) {
      return value == 'squat' ||
        value == 'lunge' ||
        value == 'push_up' ||
        value == 'sit_up' ||
        value == 'crunch' ||
        value == 'reverse_crunch' ||
        value == 'biceps_curl' ||
        value == 'lying_leg_raise' ||
        value == 'bent_knee_leg_raise' ||
        value == 'standing_hamstring_curl' ||
        value == 'standing_hip_abduction' ||
        value == 'triceps_dip' ||
        value == 'romanian_deadlift' ||
        value == 'good_morning' ||
        value == 'lateral_raise' ||
        value == 'shoulder_press' ||
        value == 'overhead_triceps_extension' ||
        value == 'upright_row' ||
        value == 'calf_raise' ||
        value == 'front_raise' ||
        value == 'glute_bridge' ||
        value == 'jumping_jack' ||
        value == 'standing_hip_extension' ||
        value == 'standing_knee_raise' ||
        value == 'standing_straight_leg_raise' ||
        value == 'v_up' ||
        value == 'frog_pump' ||
        value == 'lying_triceps_extension' ||
        value == 'floor_chest_press' ||
        value == 'y_raise';
    }

    function isHoldChallengeExercise(value) {
      return value == 'plank' ||
        value == 'hollow_hold' ||
        value == 'wall_sit' ||
        value == 'side_plank';
    }

    function isChallengeExercise(value) {
      return isRepChallengeExercise(value) || isHoldChallengeExercise(value);
    }

    function isChallengeMetric(value) {
      return value == 'validRepetitions' ||
        value == 'trustedHoldSeconds';
    }

    function isChallengeEvidenceQuality(value) {
      return value == 'high' || value == 'moderate';
    }

    function isChallengePeriod(value) {
      return value == 'daily' ||
        value == 'weekly' ||
        value == 'monthly';
    }

    function isMedalTier(value) {
      return value == 'bronze' ||
        value == 'silver' ||
        value == 'gold';
    }

    function medalTierRank(value) {
      return value == 'bronze' ? 1 :
        value == 'silver' ? 2 :
        value == 'gold' ? 3 : 0;
    }

    function isValidRewardThresholds(value) {
      return value is map &&
        value.keys().hasOnly(['bronze', 'silver', 'gold']) &&
        value.keys().hasAll(['bronze', 'silver', 'gold']) &&
        value.bronze is int &&
        value.silver is int &&
        value.gold is int &&
        value.bronze > 0 &&
        value.silver > value.bronze &&
        value.gold > value.silver;
    }

    function rewardTierMatchesProgress(progress, thresholds, tier) {
      return (tier == 'bronze' &&
          progress >= thresholds.bronze &&
          progress < thresholds.silver) ||
        (tier == 'silver' &&
          progress >= thresholds.silver &&
          progress < thresholds.gold) ||
        (tier == 'gold' && progress >= thresholds.gold);
    }

    function isChallengePeriodKey(period, value) {
      return value is string &&
        (
          ((period == 'daily' || period == 'weekly') &&
            value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) ||
          (period == 'monthly' &&
            value.matches('^[0-9]{4}-[0-9]{2}$'))
        );
    }

    function isValidTierEarnedAt(value, highestTier) {
      return value is map &&
        value.keys().hasOnly(['bronze', 'silver', 'gold']) &&
        value.get('bronze', null) is timestamp &&
        (
          (highestTier == 'bronze' &&
            !value.keys().hasAny(['silver', 'gold'])) ||
          (highestTier == 'silver' &&
            value.get('silver', null) is timestamp &&
            !value.keys().hasAny(['gold']) &&
            value.silver >= value.bronze) ||
          (highestTier == 'gold' &&
            value.get('silver', null) is timestamp &&
            value.get('gold', null) is timestamp &&
            value.silver >= value.bronze &&
            value.gold >= value.silver)
        );
    }

    function hasChallengeMedalRewardFields(data) {
      return data.keys().hasOnly([
        'schemaVersion',
        'id',
        'ownerId',
        'kind',
        'challengeId',
        'catalogVersion',
        'exerciseType',
        'metric',
        'period',
        'periodKey',
        'timezoneOffsetMinutes',
        'highestTier',
        'progressValueAtHighestTier',
        'thresholdsAtAward',
        'tierEarnedAt',
        'firstEarnedAt',
        'highestTierEarnedAt',
        'historyAt',
        'qualifyingEventId',
        'isBackfilled',
        'createdAt',
        'updatedAt',
      ]) && data.keys().hasAll([
        'schemaVersion',
        'id',
        'ownerId',
        'kind',
        'challengeId',
        'catalogVersion',
        'exerciseType',
        'metric',
        'period',
        'periodKey',
        'timezoneOffsetMinutes',
        'highestTier',
        'progressValueAtHighestTier',
        'thresholdsAtAward',
        'tierEarnedAt',
        'firstEarnedAt',
        'highestTierEarnedAt',
        'historyAt',
        'qualifyingEventId',
        'isBackfilled',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidChallengeMedalRewardShape(data, userId, rewardId) {
      return hasChallengeMedalRewardFields(data) &&
        data.schemaVersion == 1 &&
        data.id == rewardId &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.kind == 'challengeMedal' &&
        data.challengeId == data.exerciseType + '_volume' &&
        data.catalogVersion is int &&
        data.catalogVersion > 0 &&
        isChallengeExercise(data.exerciseType) &&
        isChallengeMetric(data.metric) &&
        (
          (data.metric == 'validRepetitions' &&
            isRepChallengeExercise(data.exerciseType) &&
            data.progressValueAtHighestTier is int &&
            data.progressValueAtHighestTier > 0) ||
          (data.metric == 'trustedHoldSeconds' &&
            isHoldChallengeExercise(data.exerciseType) &&
            data.progressValueAtHighestTier is number &&
            data.progressValueAtHighestTier > 0)
        ) &&
        isValidRewardThresholds(data.thresholdsAtAward) &&
        rewardTierMatchesProgress(
          data.progressValueAtHighestTier,
          data.thresholdsAtAward,
          data.highestTier
        ) &&
        isChallengePeriod(data.period) &&
        isChallengePeriodKey(data.period, data.periodKey) &&
        rewardId == 'medal:' + data.challengeId + ':' +
          data.period + ':' + data.periodKey &&
        data.timezoneOffsetMinutes is int &&
        data.timezoneOffsetMinutes >= -840 &&
        data.timezoneOffsetMinutes <= 840 &&
        isMedalTier(data.highestTier) &&
        isValidTierEarnedAt(data.tierEarnedAt, data.highestTier) &&
        data.firstEarnedAt == data.tierEarnedAt.bronze &&
        data.highestTierEarnedAt ==
          (data.highestTier == 'bronze'
            ? data.tierEarnedAt.bronze
            : data.highestTier == 'silver'
              ? data.tierEarnedAt.silver
              : data.tierEarnedAt.gold) &&
        data.historyAt == data.highestTierEarnedAt &&
        data.qualifyingEventId is string &&
        data.qualifyingEventId.size() > 0 &&
        !data.qualifyingEventId.matches('.*/.*') &&
        data.isBackfilled == false &&
        data.createdAt is timestamp &&
        data.createdAt >= data.firstEarnedAt &&
        data.updatedAt is timestamp &&
        data.updatedAt >= data.createdAt &&
        data.updatedAt >= data.highestTierEarnedAt;
    }

    function isValidChallengeMedalRewardUpgrade(
      oldData,
      newData,
      userId,
      rewardId
    ) {
      return hasValidChallengeMedalRewardShape(newData, userId, rewardId) &&
        oldData.ownerId == request.auth.uid &&
        newData.schemaVersion == oldData.schemaVersion &&
        newData.id == oldData.id &&
        newData.ownerId == oldData.ownerId &&
        newData.kind == oldData.kind &&
        newData.challengeId == oldData.challengeId &&
        newData.catalogVersion == oldData.catalogVersion &&
        newData.exerciseType == oldData.exerciseType &&
        newData.metric == oldData.metric &&
        newData.thresholdsAtAward == oldData.thresholdsAtAward &&
        newData.period == oldData.period &&
        newData.periodKey == oldData.periodKey &&
        newData.timezoneOffsetMinutes == oldData.timezoneOffsetMinutes &&
        newData.isBackfilled == oldData.isBackfilled &&
        newData.createdAt == oldData.createdAt &&
        newData.firstEarnedAt == oldData.firstEarnedAt &&
        newData.tierEarnedAt.bronze == oldData.tierEarnedAt.bronze &&
        medalTierRank(newData.highestTier) >
          medalTierRank(oldData.highestTier) &&
        newData.progressValueAtHighestTier >
          oldData.progressValueAtHighestTier &&
        (
          oldData.highestTier == 'bronze' ||
          newData.tierEarnedAt.silver == oldData.tierEarnedAt.silver
        ) &&
        (
          oldData.highestTier != 'gold' ||
          newData.tierEarnedAt.gold == oldData.tierEarnedAt.gold
        ) &&
        newData.updatedAt > oldData.updatedAt;
    }

    function isAchievementId(value) {
      return value == 'first_reliable_analysis' ||
        value == 'reliable_sessions_5' ||
        value == 'exercise_explorer_3' ||
        value == 'guide_completed' ||
        value == 'controlled_tempo' ||
        value == 'planned_workout_completed' ||
        value == 'planned_workouts_5' ||
        value == 'balanced_explorer' ||
        value == 'return_after_14_days' ||
        value == 'rhythm_30_days' ||
        value == 'golden_week';
    }

    function achievementAllowsBackfill(value) {
      return value == 'first_reliable_analysis' ||
        value == 'reliable_sessions_5' ||
        value == 'exercise_explorer_3' ||
        value == 'balanced_explorer';
    }

    function hasAchievementRewardFields(data) {
      return data.keys().hasOnly([
        'schemaVersion',
        'id',
        'ownerId',
        'kind',
        'achievementId',
        'definitionVersion',
        'unlockedAt',
        'historyAt',
        'qualifyingEventId',
        'isBackfilled',
        'createdAt',
        'updatedAt',
      ]) && data.keys().hasAll([
        'schemaVersion',
        'id',
        'ownerId',
        'kind',
        'achievementId',
        'definitionVersion',
        'unlockedAt',
        'historyAt',
        'qualifyingEventId',
        'isBackfilled',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidAchievementRewardShape(data, userId, rewardId) {
      return hasAchievementRewardFields(data) &&
        data.schemaVersion == 1 &&
        data.id == rewardId &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.kind == 'achievement' &&
        isAchievementId(data.achievementId) &&
        rewardId == 'achievement:' + data.achievementId &&
        data.definitionVersion == 1 &&
        data.unlockedAt is timestamp &&
        data.historyAt == data.unlockedAt &&
        data.qualifyingEventId is string &&
        data.qualifyingEventId.size() > 0 &&
        !data.qualifyingEventId.matches('.*/.*') &&
        data.isBackfilled is bool &&
        (!data.isBackfilled || achievementAllowsBackfill(data.achievementId)) &&
        data.createdAt is timestamp &&
        data.createdAt >= data.unlockedAt &&
        data.updatedAt is timestamp &&
        data.updatedAt >= data.createdAt;
    }

    function isAchievementEventType(value) {
      return value == 'guideStepOpened' ||
        value == 'plannedWorkoutCompleted' ||
        value == 'controlledTempoSession';
    }

    function hasAchievementEventFields(data) {
      return data.keys().hasOnly([
        'id',
        'ownerId',
        'type',
        'subjectId',
        'occurredAt',
        'localDate',
        'timezoneOffsetMinutes',
        'createdAt',
      ]) && data.keys().hasAll([
        'id',
        'ownerId',
        'type',
        'subjectId',
        'occurredAt',
        'localDate',
        'timezoneOffsetMinutes',
        'createdAt',
      ]);
    }

    function hasValidAchievementEventShape(data, userId, eventId) {
      return hasAchievementEventFields(data) &&
        data.id == eventId &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isAchievementEventType(data.type) &&
        data.subjectId is string &&
        data.subjectId.size() > 0 &&
        !data.subjectId.matches('.*/.*') &&
        (
          (data.type == 'guideStepOpened' &&
            data.subjectId.matches('^[1-6]$') &&
            eventId == 'guide-step:' + data.subjectId) ||
          (data.type == 'plannedWorkoutCompleted' &&
            eventId == 'planned-workout:' + data.subjectId) ||
          (data.type == 'controlledTempoSession' &&
            eventId == 'controlled-tempo:' + data.subjectId)
        ) &&
        data.occurredAt is timestamp &&
        isLocalDateKey(data.localDate) &&
        data.timezoneOffsetMinutes is int &&
        data.timezoneOffsetMinutes >= -840 &&
        data.timezoneOffsetMinutes <= 840 &&
        data.createdAt is timestamp &&
        data.createdAt >= data.occurredAt;
    }

    function isLocalDateKey(value) {
      return value is string &&
        value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function hasProgressContributionFields(data) {
      return data.keys().hasOnly([
        'id',
        'ownerId',
        'challengeId',
        'catalogVersion',
        'exerciseType',
        'metric',
        'evidenceQuality',
        'value',
        'endedAt',
        'timezoneOffsetMinutes',
        'localDate',
        'createdAt',
        'updatedAt',
      ]) && data.keys().hasAll([
        'id',
        'ownerId',
        'challengeId',
        'catalogVersion',
        'exerciseType',
        'metric',
        'evidenceQuality',
        'value',
        'endedAt',
        'timezoneOffsetMinutes',
        'localDate',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidProgressContributionShape(data, userId, contributionId) {
      return hasProgressContributionFields(data) &&
        data.id == contributionId &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.challengeId == data.exerciseType + '_volume' &&
        data.catalogVersion is int &&
        data.catalogVersion > 0 &&
        isChallengeExercise(data.exerciseType) &&
        isChallengeMetric(data.metric) &&
        isChallengeEvidenceQuality(data.evidenceQuality) &&
        (
          (data.metric == 'validRepetitions' &&
            isRepChallengeExercise(data.exerciseType) &&
            data.value is int && data.value > 0) ||
          (data.metric == 'trustedHoldSeconds' &&
            isHoldChallengeExercise(data.exerciseType) &&
            data.value is number && data.value > 0)
        ) &&
        data.endedAt is timestamp &&
        data.timezoneOffsetMinutes is int &&
        data.timezoneOffsetMinutes >= -840 &&
        data.timezoneOffsetMinutes <= 840 &&
        isLocalDateKey(data.localDate) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt >= data.createdAt;
    }

    function isValidRepAggregateMap(value) {
      return value is map &&
        value.keys().hasOnly([
          'squat',
          'lunge',
          'push_up',
          'sit_up',
          'crunch',
          'reverse_crunch',
          'biceps_curl',
          'lying_leg_raise',
          'bent_knee_leg_raise',
          'standing_hamstring_curl',
          'standing_hip_abduction',
          'triceps_dip',
          'romanian_deadlift',
          'good_morning',
          'lateral_raise',
          'shoulder_press',
          'overhead_triceps_extension',
          'upright_row',
          'calf_raise',
          'front_raise',
          'glute_bridge',
          'jumping_jack',
          'standing_hip_extension',
          'standing_knee_raise',
          'standing_straight_leg_raise',
          'v_up',
          'frog_pump',
          'lying_triceps_extension',
          'floor_chest_press',
          'y_raise',
        ]) &&
        isNullablePositiveInt(value.get('squat', null)) &&
        isNullablePositiveInt(value.get('lunge', null)) &&
        isNullablePositiveInt(value.get('push_up', null)) &&
        isNullablePositiveInt(value.get('sit_up', null)) &&
        isNullablePositiveInt(value.get('crunch', null)) &&
        isNullablePositiveInt(value.get('reverse_crunch', null)) &&
        isNullablePositiveInt(value.get('biceps_curl', null)) &&
        isNullablePositiveInt(value.get('lying_leg_raise', null)) &&
        isNullablePositiveInt(value.get('bent_knee_leg_raise', null)) &&
        isNullablePositiveInt(value.get('standing_hamstring_curl', null)) &&
        isNullablePositiveInt(value.get('standing_hip_abduction', null)) &&
        isNullablePositiveInt(value.get('triceps_dip', null)) &&
        isNullablePositiveInt(value.get('romanian_deadlift', null)) &&
        isNullablePositiveInt(value.get('good_morning', null)) &&
        isNullablePositiveInt(value.get('lateral_raise', null)) &&
        isNullablePositiveInt(value.get('shoulder_press', null)) &&
        isNullablePositiveInt(value.get('overhead_triceps_extension', null)) &&
        isNullablePositiveInt(value.get('upright_row', null)) &&
        isNullablePositiveInt(value.get('calf_raise', null)) &&
        isNullablePositiveInt(value.get('front_raise', null)) &&
        isNullablePositiveInt(value.get('glute_bridge', null)) &&
        isNullablePositiveInt(value.get('jumping_jack', null)) &&
        isNullablePositiveInt(value.get('standing_hip_extension', null)) &&
        isNullablePositiveInt(value.get('standing_knee_raise', null)) &&
        isNullablePositiveInt(value.get('standing_straight_leg_raise', null)) &&
        isNullablePositiveInt(value.get('v_up', null)) &&
        isNullablePositiveInt(value.get('frog_pump', null)) &&
        isNullablePositiveInt(value.get('lying_triceps_extension', null)) &&
        isNullablePositiveInt(value.get('floor_chest_press', null)) &&
        isNullablePositiveInt(value.get('y_raise', null));
    }

    function isNullablePositiveInt(value) {
      return value == null || (value is int && value > 0);
    }

    function isNullablePositiveNumber(value) {
      return value == null || (value is number && value > 0);
    }

    function isValidHoldAggregateMap(value) {
      return value is map &&
        value.keys().hasOnly([
          'plank',
          'hollow_hold',
          'wall_sit',
          'side_plank',
        ]) &&
        isNullablePositiveNumber(value.get('plank', null)) &&
        isNullablePositiveNumber(value.get('hollow_hold', null)) &&
        isNullablePositiveNumber(value.get('wall_sit', null)) &&
        isNullablePositiveNumber(value.get('side_plank', null));
    }

    function isValidChallengeExerciseList(value) {
      return value is list && value.hasOnly([
        'squat',
        'plank',
        'hollow_hold',
        'lunge',
        'push_up',
        'sit_up',
        'crunch',
        'reverse_crunch',
        'biceps_curl',
        'lying_leg_raise',
        'bent_knee_leg_raise',
        'standing_hamstring_curl',
        'standing_hip_abduction',
        'triceps_dip',
        'romanian_deadlift',
        'good_morning',
        'lateral_raise',
        'shoulder_press',
        'overhead_triceps_extension',
        'upright_row',
        'calf_raise',
        'front_raise',
        'glute_bridge',
        'wall_sit',
        'side_plank',
        'jumping_jack',
        'standing_hip_extension',
        'standing_knee_raise',
        'standing_straight_leg_raise',
        'v_up',
        'frog_pump',
        'lying_triceps_extension',
        'floor_chest_press',
        'y_raise',
      ]);
    }

    function hasActivityDayFields(data) {
      return data.keys().hasOnly([
        'id',
        'ownerId',
        'localDate',
        'trustedSessionCount',
        'highReliabilitySessionCount',
        'validRepsByExercise',
        'holdSecondsByExercise',
        'exerciseTypes',
        'createdAt',
        'updatedAt',
      ]) && data.keys().hasAll([
        'id',
        'ownerId',
        'localDate',
        'trustedSessionCount',
        'highReliabilitySessionCount',
        'validRepsByExercise',
        'holdSecondsByExercise',
        'exerciseTypes',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidActivityDayShape(data, userId, localDate) {
      return hasActivityDayFields(data) &&
        data.id == localDate &&
        data.localDate == localDate &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isLocalDateKey(data.localDate) &&
        data.trustedSessionCount is int &&
        data.trustedSessionCount > 0 &&
        data.highReliabilitySessionCount is int &&
        data.highReliabilitySessionCount >= 0 &&
        data.highReliabilitySessionCount <= data.trustedSessionCount &&
        isValidRepAggregateMap(data.validRepsByExercise) &&
        isValidHoldAggregateMap(data.holdSecondsByExercise) &&
        data.validRepsByExercise.size() +
          data.holdSecondsByExercise.size() > 0 &&
        isValidChallengeExerciseList(data.exerciseTypes) &&
        data.exerciseTypes.size() ==
          data.validRepsByExercise.size() +
          data.holdSecondsByExercise.size() &&
        data.exerciseTypes.size() <= data.trustedSessionCount &&
        data.exerciseTypes.hasAll(data.validRepsByExercise.keys()) &&
        data.exerciseTypes.hasAll(data.holdSecondsByExercise.keys()) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt >= data.createdAt;
    }

    function isWorkoutGoalType(value) {
      return value == 'weeklySessions' ||
        value == 'weeklyReps' ||
        value == 'averageScore';
    }

    function isWorkoutGoalPeriod(value) {
      return value == 'weekly' || value == 'allTime';
    }

    function isWorkoutGoalStatus(value) {
      return value == 'active' || value == 'paused';
    }

    function hasGoalFields(data) {
      return data.keys().hasOnly([
        'id',
        'ownerId',
        'type',
        'period',
        'targetValue',
        'status',
        'createdAt',
        'updatedAt',
      ]) && data.keys().hasAll([
        'id',
        'ownerId',
        'type',
        'period',
        'targetValue',
        'status',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidGoalTarget(data) {
      return data.targetValue is number &&
        (
          (data.type == 'weeklySessions' &&
            data.targetValue is int &&
            data.targetValue >= 1 && data.targetValue <= 14) ||
          (data.type == 'weeklyReps' &&
            data.targetValue is int &&
            data.targetValue >= 10 && data.targetValue <= 1000) ||
          (data.type == 'averageScore' &&
            data.targetValue >= 1 && data.targetValue <= 100)
        );
    }

    function hasValidGoalShape(data, userId, goalId) {
      return hasGoalFields(data) &&
        data.id is string &&
        data.id == goalId &&
        data.ownerId is string &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isWorkoutGoalType(data.type) &&
        data.id == data.type &&
        isWorkoutGoalPeriod(data.period) &&
        (
          (data.type == 'averageScore' && data.period == 'allTime') ||
          (data.type != 'averageScore' && data.period == 'weekly')
        ) &&
        hasValidGoalTarget(data) &&
        isWorkoutGoalStatus(data.status) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt >= data.createdAt;
    }

    function isValidSessionCreate(userId, sessionId) {
      return isOwner(userId) &&
        hasSessionFields() &&
        hasValidSessionShape(userId, sessionId);
    }

    function isValidSessionUpdate(userId, sessionId) {
      return isOwner(userId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.id == resource.data.id &&
        hasSessionFields() &&
        hasValidSessionShape(userId, sessionId);
    }

    function hasRepFields(data) {
      return data.keys().hasOnly([
        'id',
        'ownerId',
        'sessionId',
        'exerciseType',
        'analysisKind',
        'repIndex',
        'score',
        'isValid',
        'validationStatus',
        'invalidReason',
        'validationReasons',
        'endedAt',
        'durationSeconds',
        'minPrimaryMetric',
        'worstFormMetric',
        'descentMillis',
        'ascentMillis',
        'hadFormViolation',
        'hadCoverageDrop',
        'switchedSideDuringRep',
        'completedPhaseSequence',
        'selectedSide',
        'measurementConfidence',
        'confidence',
        'primaryRom',
        'eccentricMillis',
        'concentricMillis',
        'tempoMeasurementStatus',
        'tempoMeasurementIssues',
        'tempoQuality',
        'tempoSeverity',
        'tempoReasons',
        'tempoIncludedInScore',
        'tempoTotalMillis',
        'techniqueObservations',
        'coverageQuality',
        'feedback',
        'createdAt',
      ]);
    }

    function hasValidRepShape(data, userId, sessionId, repId) {
      let validationReasons = data.get('validationReasons', null);
      let measurementConfidence = data.get('measurementConfidence', null);
      let confidence = data.get('confidence', null);
      return data.id == repId &&
        data.ownerId == userId &&
        data.sessionId == sessionId &&
        data.exerciseType is string &&
        data.analysisKind is string &&
        data.repIndex is int &&
        data.repIndex >= 1 &&
        data.isValid is bool &&
        data.createdAt is timestamp &&
        isNullableScore(data.get('score', null)) &&
        isNullableString(data.get('validationStatus', null)) &&
        isNullableString(data.get('invalidReason', null)) &&
        (validationReasons == null || validationReasons is list) &&
        isNullableTimestamp(data.get('endedAt', null)) &&
        isNullableNonNegativeNumber(data.get('durationSeconds', null)) &&
        isNullableNumber(data.get('minPrimaryMetric', null)) &&
        isNullableNumber(data.get('worstFormMetric', null)) &&
        isNullableNonNegativeInt(data.get('descentMillis', null)) &&
        isNullableNonNegativeInt(data.get('ascentMillis', null)) &&
        isNullableBool(data.get('hadFormViolation', null)) &&
        isNullableBool(data.get('hadCoverageDrop', null)) &&
        isNullableBool(data.get('switchedSideDuringRep', null)) &&
        isNullableBool(data.get('completedPhaseSequence', null)) &&
        isNullableString(data.get('selectedSide', null)) &&
        isNullableMeasurementConfidenceBreakdown(measurementConfidence) &&
        isNullableUnitInterval(confidence) &&
        (
          measurementConfidence == null ||
          confidence == measurementConfidence.get('combined', null)
        ) &&
        isNullableNonNegativeNumber(data.get('primaryRom', null)) &&
        isNullableNonNegativeInt(data.get('eccentricMillis', null)) &&
        isNullableNonNegativeInt(data.get('concentricMillis', null)) &&
        isNullableTempoMeasurementStatus(
          data.get('tempoMeasurementStatus', null),
        ) &&
        isNullableList(data.get('tempoMeasurementIssues', null)) &&
        isNullableTempoQuality(data.get('tempoQuality', null)) &&
        isNullableTempoSeverity(data.get('tempoSeverity', null)) &&
        isNullableList(data.get('tempoReasons', null)) &&
        isNullableBool(data.get('tempoIncludedInScore', null)) &&
        isNullableNonNegativeInt(data.get('tempoTotalMillis', null)) &&
        isNullableList(data.get('techniqueObservations', null)) &&
        isNullableUnitInterval(data.get('coverageQuality', null)) &&
        isNullableString(data.get('feedback', null));
    }

    function isValidRepWrite(userId, sessionId, repId) {
      let data = request.resource.data;
      return isOwner(userId) &&
        hasRepFields(data) &&
        hasValidRepShape(data, userId, sessionId, repId);
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if isOwner(userId);

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          hasValidGoalShape(request.resource.data, userId, goalId);
        allow update: if isOwner(userId) &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.period == resource.data.period &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt >= resource.data.updatedAt &&
          hasValidGoalShape(request.resource.data, userId, goalId);
        allow delete: if isOwner(userId);
      }


      match /progressContributions/{contributionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          hasValidProgressContributionShape(
            request.resource.data,
            userId,
            contributionId
          );
        allow update: if isOwner(userId) &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAt == resource.data.createdAt &&
          hasValidProgressContributionShape(
            request.resource.data,
            userId,
            contributionId
          );
        allow delete: if isOwner(userId);
      }

      match /activityDays/{localDate} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          hasValidActivityDayShape(request.resource.data, userId, localDate);
        allow update: if isOwner(userId) &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.localDate == resource.data.localDate &&
          request.resource.data.createdAt == resource.data.createdAt &&
          hasValidActivityDayShape(request.resource.data, userId, localDate);
        allow delete: if isOwner(userId);
      }

      match /achievementEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          hasValidAchievementEventShape(
            request.resource.data,
            userId,
            eventId
          );
        allow update, delete: if false;
      }

      match /rewards/{rewardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          (
            hasValidChallengeMedalRewardShape(
              request.resource.data,
              userId,
              rewardId
            ) ||
            hasValidAchievementRewardShape(
              request.resource.data,
              userId,
              rewardId
            )
          );
        allow update: if isOwner(userId) &&
          resource.data.kind == 'challengeMedal' &&
          isValidChallengeMedalRewardUpgrade(
            resource.data,
            request.resource.data,
            userId,
            rewardId
          );
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isValidSessionCreate(userId, sessionId);
        allow update: if isValidSessionUpdate(userId, sessionId);
        allow delete: if isOwner(userId);

        match /reps/{repId} {
          allow read: if isOwner(userId);
          allow create, update: if isValidRepWrite(
            userId,
            sessionId,
            repId,
          );
          allow delete: if isOwner(userId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
