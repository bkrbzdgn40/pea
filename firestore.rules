rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isNullableNumber(value) {
      return value == null || value is number;
    }

    function isScore(value) {
      return value is number && value >= 0 && value <= 100;
    }

    function isNullableScore(value) {
      return value == null || isScore(value);
    }

    function isNullableInt(value) {
      return value == null || value is int;
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isNullableNonNegativeInt(value) {
      return value == null || isNonNegativeInt(value);
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function isNullableNonNegativeNumber(value) {
      return value == null || isNonNegativeNumber(value);
    }

    function isNullableBool(value) {
      return value == null || value is bool;
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function hasSessionFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'exerciseType',
        'analysisKind',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'totalReps',
        'validReps',
        'invalidReps',
        'averageScore',
        'bestScore',
        'worstScore',
        'formWarningCount',
        'holdDurationSeconds',
        'bestHoldSeconds',
        'holdFormBreakCount',
        'createdAt',
        'updatedAt',
      ]) &&
      request.resource.data.keys().hasAll([
        'id',
        'ownerId',
        'exerciseType',
        'analysisKind',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'totalReps',
        'validReps',
        'invalidReps',
        'averageScore',
        'bestScore',
        'worstScore',
        'formWarningCount',
        'holdDurationSeconds',
        'bestHoldSeconds',
        'holdFormBreakCount',
        'createdAt',
        'updatedAt',
      ]);
    }

    function hasValidSessionShape(userId, sessionId) {
      return request.resource.data.id is string &&
        request.resource.data.id == sessionId &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId == userId &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.exerciseType is string &&
        request.resource.data.analysisKind is string &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.endedAt is timestamp &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.endedAt >= request.resource.data.startedAt &&
        isNonNegativeInt(request.resource.data.durationSeconds) &&
        isNonNegativeInt(request.resource.data.totalReps) &&
        isNonNegativeInt(request.resource.data.validReps) &&
        isNonNegativeInt(request.resource.data.invalidReps) &&
        request.resource.data.validReps + request.resource.data.invalidReps <=
          request.resource.data.totalReps &&
        isScore(request.resource.data.averageScore) &&
        isScore(request.resource.data.bestScore) &&
        isScore(request.resource.data.worstScore) &&
        isNonNegativeInt(request.resource.data.formWarningCount) &&
        isNonNegativeNumber(request.resource.data.holdDurationSeconds) &&
        isNonNegativeNumber(request.resource.data.bestHoldSeconds) &&
        isNonNegativeInt(request.resource.data.holdFormBreakCount);
    }

    function isValidSessionCreate(userId, sessionId) {
      return isOwner(userId) &&
        hasSessionFields() &&
        hasValidSessionShape(userId, sessionId);
    }

    function isValidSessionUpdate(userId, sessionId) {
      return isOwner(userId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.id == resource.data.id &&
        hasSessionFields() &&
        hasValidSessionShape(userId, sessionId);
    }

    function hasRepFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'sessionId',
        'exerciseType',
        'analysisKind',
        'repIndex',
        'score',
        'isValid',
        'validationStatus',
        'invalidReason',
        'validationReasons',
        'endedAt',
        'durationSeconds',
        'minPrimaryMetric',
        'worstFormMetric',
        'descentMillis',
        'ascentMillis',
        'hadFormViolation',
        'hadCoverageDrop',
        'switchedSideDuringRep',
        'completedPhaseSequence',
        'selectedSide',
        'feedback',
        'createdAt',
      ]) &&
      request.resource.data.keys().hasAll([
        'id',
        'ownerId',
        'sessionId',
        'exerciseType',
        'analysisKind',
        'repIndex',
        'isValid',
        'createdAt',
      ]);
    }

    function hasValidRepShape(userId, sessionId, repId) {
      return request.resource.data.id is string &&
        request.resource.data.id == repId &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId == userId &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.exerciseType is string &&
        request.resource.data.analysisKind is string &&
        request.resource.data.repIndex is int &&
        request.resource.data.repIndex >= 1 &&
        request.resource.data.isValid is bool &&
        request.resource.data.createdAt is timestamp &&
        isNullableScore(request.resource.data.score) &&
        isNullableString(request.resource.data.validationStatus) &&
        isNullableString(request.resource.data.invalidReason) &&
        (
          request.resource.data.validationReasons == null ||
          request.resource.data.validationReasons is list
        ) &&
        isNullableTimestamp(request.resource.data.endedAt) &&
        isNullableNonNegativeNumber(request.resource.data.durationSeconds) &&
        isNullableNumber(request.resource.data.minPrimaryMetric) &&
        isNullableNumber(request.resource.data.worstFormMetric) &&
        isNullableNonNegativeInt(request.resource.data.descentMillis) &&
        isNullableNonNegativeInt(request.resource.data.ascentMillis) &&
        isNullableBool(request.resource.data.hadFormViolation) &&
        isNullableBool(request.resource.data.hadCoverageDrop) &&
        isNullableBool(request.resource.data.switchedSideDuringRep) &&
        isNullableBool(request.resource.data.completedPhaseSequence) &&
        isNullableString(request.resource.data.selectedSide) &&
        isNullableString(request.resource.data.feedback);
    }

    function isValidRepCreate(userId, sessionId, repId) {
      return isOwner(userId) &&
        hasRepFields() &&
        hasValidRepShape(userId, sessionId, repId);
    }

    function isValidRepUpdate(userId, sessionId, repId) {
      return isOwner(userId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.sessionId == resource.data.sessionId &&
        hasRepFields() &&
        hasValidRepShape(userId, sessionId, repId);
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isValidSessionCreate(userId, sessionId);
        allow update: if isValidSessionUpdate(userId, sessionId);
        allow delete: if isOwner(userId);

        match /reps/{repId} {
          allow read: if isOwner(userId);
          allow create: if isValidRepCreate(userId, sessionId, repId);
          allow update: if isValidRepUpdate(userId, sessionId, repId);
          allow delete: if isOwner(userId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
