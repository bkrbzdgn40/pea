{
  "name": "pea-platform-functions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:core": "node --experimental-strip-types --test test/*.test.ts",
    "test": "npm run build && node --test lib/test/*.test.js",
    "test:emulator": "npm run build && node --test lib/test/*.emulator.test.js",
    "check": "npm run test:core && npm run test"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
